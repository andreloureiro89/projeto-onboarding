# Copiar para .env e preencher com valores reais.
# O ficheiro .env está em .gitignore e nunca deve ser versionado.

PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# Segredo usado para assinar os tokens JWT.
# Gerar um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<gerar-um-segredo-aleatorio>

# Connection string do MongoDB Atlas.
MONGODB_URI=mongodb+srv://<utilizador>:<password>@<cluster>.mongodb.net/novatech?retryWrites=true&w=majority

# Percentagem mínima de acerto para aprovação num questionário (opcional).
QUIZ_PASSING_SCORE=70
